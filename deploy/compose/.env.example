# Copy to .env and replace every value. The admin is created on first start only.
POSTGRES_PASSWORD=change-me-postgres
CLICKHOUSE_PASSWORD=change-me-clickhouse
CODEATLAS_ADMIN_EMAIL=admin@example.com
# 12-72 characters
CODEATLAS_ADMIN_PASSWORD=change-me-admin-password
# Set to true when serving over HTTPS
CODEATLAS_COOKIE_SECURE=false
CODEATLAS_PORT=8080
